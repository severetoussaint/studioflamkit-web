# Environment variables (example)

# --- PUBLIC VARIABLES (AVAILABLE IN THE BROWSER) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SERVER ONLY VARIABLES (DO NOT EXPOSE TO CLIENT) ---
